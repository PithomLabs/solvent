# Centralized configuration for Solvent demo scripts.
# Sourced by all demo scripts and referenced by Taskfile.yml.
SOLVENT_DB_NAME=fable
SOLVENT_PORT=26260
SOLVENT_HTTP_PORT=8081
SOLVENT_CRDB_CONTAINER=solvent-crdb
SOLVENT_DSN=postgresql://root@localhost:26260/fable?sslmode=disable
SOLVENT_SCENARIO_1=00000000-0000-0000-0000-000000000001
SOLVENT_SCENARIO_2=00000000-0000-0000-0000-000000000002

# Second embedding target, used by `task corpus:embed:cloud` to write the same
# checkpoint vectors into the hosted database in the same pass.
#
# Deliberately left unset. This file is tracked in git, and a CockroachDB Cloud DSN
# carries a password; the repo already has one credential in its history that needs
# rotating, and a second is not wanted. Supply it from outside the repo instead:
#
#   FABLE_DSN_2="$(cat ~/somewhere-outside-the-repo/cloud.dsn)" task corpus:embed:cloud
#
# FABLE_DSN_2=
