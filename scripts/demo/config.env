# Centralized configuration for Solvent demo scripts.
# Sourced by all demo scripts and referenced by Taskfile.yml.
SOLVENT_DB_NAME=fable
SOLVENT_PORT=26260
SOLVENT_HTTP_PORT=8081
SOLVENT_CRDB_CONTAINER=solvent-crdb
SOLVENT_DSN=postgresql://root@localhost:26260/fable?sslmode=disable
SOLVENT_SCENARIO_1=00000000-0000-0000-0000-000000000001
SOLVENT_SCENARIO_2=00000000-0000-0000-0000-000000000002
